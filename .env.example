PORT=8787
NODE_ENV=production
BASE_PATH=/

# Database — use your host’s Postgres, or start local Docker and use the line below:
#   pnpm db:up
# Then: pnpm --filter @workspace/db run push
DATABASE_URL=postgres://ziadah:ziadah@127.0.0.1:5432/ziadah

# CMS authentication
JWT_SECRET=replace_with_at_least_32_characters_long_secret
JWT_REFRESH_SECRET=replace_with_different_32_plus_char_secret
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=replace_with_strong_password
CMS_ADMIN_NAME=CMS Admin

# Email (feature-request endpoint)
SMTP_USER=example@gmail.com
SMTP_PASS=replace_with_smtp_password_or_app_password

# OpenAI — للتحليل (واحد من الخيارين)
# تكامل Replit: يجب ضبط الاثنين معاً (المفتاح وحده لا يكفي)
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# أو مفتاح OpenAI مباشرة (OpenAI API):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# نموذج التحليل (اختياري؛ الافتراضي gpt-4o)
# OPENAI_ANALYSIS_MODEL=gpt-4o
# وضع JSON الصارم من OpenAI (افتراضي مفعّل؛ عطّل إذا وكيل Replit لا يدعمه)
# OPENAI_ANALYSIS_JSON_MODE=true

# Frontend/API wiring — leave VITE_* unset locally so Vite proxies `/api` to API_SERVER_PROXY_TARGET.
# VITE_API_BASE_URL=https://ziadah.app
API_SERVER_PROXY_TARGET=http://127.0.0.1:8787

# CORS
CORS_ALLOWED_ORIGINS=https://ziadah.app,https://www.ziadah.app
