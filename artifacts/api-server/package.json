{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'node build.mjs --watch & sleep 2 && export NODE_ENV=development PORT=\"${PORT:-8787}\" && exec node --watch --enable-source-maps ./dist/index.mjs'",
    "dev:once": "sh -c 'export NODE_ENV=development && export PORT=\"${PORT:-8787}\" && pnpm run build && pnpm run start'",
    "build": "node ./build.mjs",
    "start": "sh -c 'export PORT=\"${PORT:-8787}\" && node --enable-source-maps ./dist/index.mjs'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0-rc.3",
    "nodemailer": "^6.9.16",
    "openai": "^6.34.0",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "@types/nodemailer": "^6.4.17",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
