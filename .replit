run = "bash scripts/replit-run.sh"
modules = ["nodejs-24"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[env]
JWT_SECRET = "YkFwcTU9aqruIFWZn0WO6zotqTvohjer"
CMS_ADMIN_EMAIL = "admin@ziadah.app"
CMS_ADMIN_PASSWORD = "Admin@ziadah2024"
BASE_PATH = "/"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
